  if (camMode === 0) {
    const off = new THREE.Vector3(0, 2.8, -7).applyQuaternion(cq).add(cp);
    if (!camInit) { camPos.copy(off); camInit = true; }
    camPos.lerp(off, 1 - Math.pow(0.001, dt));
    camPos.y = Math.max(camPos.y, 1);
    camera.position.copy(camPos);
    camLook.lerp(cp, 0.15);
    camera.lookAt(camLook);
  } else if (camMode === 1) {
    const off = new THREE.Vector3(0, 1.1, 0.3).applyQuaternion(cq).add(cp);
    camera.position.copy(off);
    camera.lookAt(new THREE.Vector3(0, 1, 15).applyQuaternion(cq).add(cp));
  } else {
    const t = performance.now() * 0.0005;
    const r = 10;
    camera.position.set(cp.x + Math.cos(t)*r, cp.y + 4, cp.z + Math.sin(t)*r);
    camera.lookAt(cp);
  }
}

