function detachPart(p, dir, impactForce) {
  if (!p.mesh.parent || p.noDetach) return;
  const mesh = p.mesh;
  mesh.updateWorldMatrix(true, true);
  const box = new THREE.Box3().setFromObject(mesh);
  const center = box.getCenter(new THREE.Vector3());
  const size = box.getSize(new THREE.Vector3());
  carGroup.remove(mesh);
  const holder = new THREE.Group();
  scene.add(holder);
  holder.position.copy(center);
  holder.attach(mesh);
  const body = new CANNON.Body({ mass: p.mass, material: matCar, linearDamping: 0.02, angularDamping: 0.15 });
  body.addShape(new CANNON.Box(new CANNON.Vec3(Math.max(size.x/2, 0.1), Math.max(size.y/2, 0.1), Math.max(size.z/2, 0.1))));
  body.position.set(center.x, center.y, center.z);
  body.velocity.copy(chassisBody.velocity);
  body.velocity.x += dir.x*impactForce*0.5 + (Math.random()-0.5)*5;
  body.velocity.y += 4 + Math.random()*4;
  body.velocity.z += dir.z*impactForce*0.5 + (Math.random()-0.5)*5;
  body.angularVelocity.set((Math.random()-0.5)*14, (Math.random()-0.5)*14, (Math.random()-0.5)*14);
  world.addBody(body);
  let constraint = null;
  if (impactForce < 14) {
    let maxForce = 90000, maxStretch = 2.5;
    if (impactForce < 4) { maxForce = 110000; maxStretch = 3.0; }
    else if (impactForce < 8) { maxForce = 50000; maxStretch = 2.0; }
    else { maxForce = 20000; maxStretch = 1.5; }
    const dx = center.x - chassisBody.position.x;
    const dy = center.y - chassisBody.position.y;
    const dz = center.z - chassisBody.position.z;
    const dist = Math.sqrt(dx*dx+dy*dy+dz*dz);
    constraint = new CANNON.DistanceConstraint(chassisBody, body, dist, maxForce);
    world.addConstraint(constraint);
  }
  const pi = parts.indexOf(p); if (pi >= 0) parts.splice(pi, 1);
  const di = deformables.indexOf(mesh); if (di >= 0) deformables.splice(di, 1);
  freeParts.push({ holder, body, constraint, startDistance: constraint ? constraint.distance : 0, maxStretch: constraint ? 3.0 : 0, broken: !constraint });
  for (let i = 0; i < 8; i++) dustPS.spawn(center.x, center.y, center.z, (Math.random()-0.5)*4, Math.random()*2, (Math.random()-0.5)*4, 0.7+Math.random(), 0.5+Math.random()*0.5);
}

function shatterPart(p, dir, impactForce) {
  if (!p.mesh.parent) return;
  const mesh = p.mesh;
  const box = new THREE.Box3().setFromObject(mesh);
  const center = box.getCenter(new THREE.Vector3());
  const size = box.getSize(new THREE.Vector3());
  carGroup.remove(mesh);

  if (p.isGlass) {
    for (let i = 0; i < 24; i++) {
      debrisPS.spawn(center.x, center.y, center.z, (Math.random()-0.5)*7, Math.random()*5, (Math.random()-0.5)*7, 0.8+Math.random()*1.2, 0.1+Math.random()*0.18);
    }
    scene.remove(mesh);
  } else {
    let fragMat = null;
    mesh.traverse(o => { if (!fragMat && o.isMesh && o.material) fragMat = o.material.clone(); });
    if (!fragMat) fragMat = new THREE.MeshStandardMaterial({ color: 0x888888, roughness: 0.7 });
    if (fragMat.vertexColors) fragMat.vertexColors = false;
    if (fragMat.transparent) fragMat.transparent = false;
    const NX = 3, NY = 2, NZ = 3;
    for (let ix = 0; ix < NX; ix++) for (let iy = 0; iy < NY; iy++) for (let iz = 0; iz < NZ; iz++) {
      const fw = size.x/NX * (0.7+Math.random()*0.3);
      const fh = size.y/NY * (0.7+Math.random()*0.3);
      const fdz = size.z/NZ * (0.7+Math.random()*0.3);
      const fm = new THREE.Mesh(new THREE.BoxGeometry(fw, fh, fdz), fragMat);
      fm.castShadow = true;
      const fg = new THREE.Group();
      scene.add(fg); fg.add(fm);
      fg.position.set(
        center.x + (ix - NX/2 + 0.5)*(size.x/NX),
        center.y + (iy - NY/2 + 0.5)*(size.y/NY),
        center.z + (iz - NZ/2 + 0.5)*(size.z/NZ)
      );
      const b = new CANNON.Body({ mass: Math.max(0.5, p.mass/(NX*NY*NZ)), material: matCar, linearDamping: 0.02, angularDamping: 0.15 });
      b.addShape(new CANNON.Box(new CANNON.Vec3(fw/2, fh/2, fdz/2)));
      b.position.copy(fg.position);
      b.velocity.copy(chassisBody.velocity);
      const sp = 4 + impactForce*0.6;
      b.velocity.x += dir.x*sp + (Math.random()-0.5)*7;
      b.velocity.y += Math.random()*7 + 3;
      b.velocity.z += dir.z*sp + (Math.random()-0.5)*7;
      b.angularVelocity.set((Math.random()-0.5)*20, (Math.random()-0.5)*20, (Math.random()-0.5)*20);
      world.addBody(b);
      freeParts.push({ holder: fg, body: b, constraint: null, broken: true });
    }
    scene.remove(mesh);
    for (let i = 0; i < 15; i++) sparkPS.spawn(center.x, center.y, center.z, (Math.random()-0.5)*9, Math.random()*7, (Math.random()-0.5)*9, 0.4+Math.random()*0.5, 0.1+Math.random()*0.12);
  }
  const pi = parts.indexOf(p); if (pi >= 0) parts.splice(pi, 1);
  const di = deformables.indexOf(mesh); if (di >= 0) deformables.splice(di, 1);
}

/* ============================================================================
   УРОН — СИЛЬНО УСИЛЕН
   ============================================================================ */
function onCarCollide(e) {
  const c = e.contact;
  if (!c) return;
  const impact = Math.abs(c.getImpactVelocityAlongNormal());
  if (impact < 0.3) return;
  const now = performance.now();
  if (impact > 1.2) { if (now - lastCollideTime < 20) return; lastCollideTime = now; }

  const otherBody = c.bi === chassisBody ? c.bj : c.bi;
  const otherMass = otherBody.mass;

  const worldPoint = new THREE.Vector3();
  if (c.bi === chassisBody) worldPoint.set(c.bi.position.x + c.ri.x, c.bi.position.y + c.ri.y, c.bi.position.z + c.ri.z);
  else worldPoint.set(c.bj.position.x + c.rj.x, c.bj.position.y + c.rj.y, c.bj.position.z + c.rj.z);

  let dir;
  if (c.ni) {
    dir = new THREE.Vector3(c.ni.x, c.ni.y, c.ni.z);
    if (c.bi === chassisBody) dir.negate();
  } else {
    dir = new THREE.Vector3(chassisBody.position.x - worldPoint.x, chassisBody.position.y - worldPoint.y, chassisBody.position.z - worldPoint.z);
  }
  if (dir.lengthSq() < 0.001) dir.set(0, 0, 1);
  dir.normalize();

  // ⬇⬇⬇ УСИЛЕНО В ~3 РАЗА
  let dmg = impact * impact * 0.2;
  let typeMult;
  if (otherMass === 0) {
    typeMult = 4.0;      // Заборы/стены — БЕТОН
  } else if (otherMass > 500) {
    typeMult = 3.0;      // Тяжёлые блоки
  } else if (otherMass < 50) {
    typeMult = 0.25;     // Конусы, бочки
  } else {
    typeMult = 1.5;      // Средние
  }
  dmg *= typeMult;
  dmg = Math.min(dmg, 55);  // ⬅ лимит вырос с 22 до 55
  damage = Math.min(damage + dmg, 100);
  flashDamage(Math.min(dmg / 5, 1));
  audio.playImpact(Math.min(impact / 10, 1));

  // Сила деформации ⬆
  const baseStrength = Math.min(impact * 0.14 * typeMult, 1.5);
  const tmp = new THREE.Vector3();
  const affected = [];
  for (const m of deformables) {
    if (!m.parent) continue;
    m.getWorldPosition(tmp);
    const dist = tmp.distanceTo(worldPoint);
    if (dist < 2.4) affected.push({ mesh: m, dist });  // ⬅ радиус 1.6 → 2.4
  }
  affected.sort((a, b) => a.dist - b.dist);
  for (let k = 0; k < Math.min(affected.length, 6); k++) {  // ⬅ 4 → 6 деталей
    const { mesh, dist } = affected[k];
    const falloff = k === 0 ? 1.0 : Math.max(0.5, 1 - dist / 2.6);
    deformMesh(mesh, worldPoint, dir.clone(), baseStrength * falloff);
  }

  for (const p of [...parts]) {
    if (!p.mesh.parent || p.noDetach) continue;
    p.mesh.getWorldPosition(tmp);
    const d = tmp.distanceTo(worldPoint);
    if (d < 1.8) {  // ⬅ 1.4 → 1.8
      let partDamage = impact * 1.8;  // ⬅ 0.7 → 1.8
      if (otherMass === 0) partDamage *= 3.0;
      else if (otherMass > 500) partDamage *= 2.5;
      else if (otherMass < 50) partDamage *= 0.15;

      p.hp -= partDamage;
      if (p.isGlass && p.hp < p.maxHp * 0.6 && !p.cracked) {
        p.cracked = true;
        p.mesh.material = new THREE.MeshStandardMaterial({ map: texCrack, color: 0xbfd8ea, transparent: true, opacity: 0.85, metalness: 0.3, roughness: 0.3, side: THREE.DoubleSide });
      }
      if (p.hp <= 0) {
        if (p.shatterable && Math.random() < 0.9) shatterPart(p, dir, impact);
        else detachPart(p, dir, Math.min(impact * 0.7, 20));
      }
    }
  }

  for (let i = 0; i < 4; i++) {
    if (tireBurst[i]) continue;
    const wp = vehicle.wheelInfos[i].worldTransform.position;
    const d = Math.hypot(wp.x - worldPoint.x, wp.y - worldPoint.y, wp.z - worldPoint.z);
    if (d < 1.2) {
      let tireDmg = impact * 1.2;  // ⬅ 0.5 → 1.2
      if (otherMass === 0 || otherMass > 500) tireDmg *= 3.0;
      else if (otherMass < 50) tireDmg *= 0.15;
      tireHealth[i] -= tireDmg;
      if (tireHealth[i] <= 0) burstTire(i);
    }
  }

  const n = Math.min(Math.floor(impact * 2.2), 30);
  for (let i = 0; i < n; i++) {
    sparkPS.spawn(worldPoint.x, worldPoint.y, worldPoint.z, dir.x*Math.random()*6 + (Math.random()-0.5)*7, Math.random()*7, dir.z*Math.random()*6 + (Math.random()-0.5)*7, 0.3+Math.random()*0.6, 0.1+Math.random()*0.18);
  }
  if (impact > 3) {
    for (let i = 0; i < 15; i++) {
      dustPS.spawn(worldPoint.x, worldPoint.y, worldPoint.z, (Math.random()-0.5)*6, Math.random()*4, (Math.random()-0.5)*6, 0.8+Math.random()*1.0, 0.7+Math.random()*1.0);
    }
  }
}

