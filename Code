/* ===== 12. УПРАВЛЕНИЕ ===== */
const MAX_FORCE_BASE = 1800;
const MAX_ENGINE_FORCE = 45000;
const MAX_VELOCITY = 300;

function updateCar(dt) {
  readKeys();
  const finalInput = {
    throttle: Math.max(input.throttle, touchGas),
    brake: Math.max(input.brake, touchBrake),
    steer: Math.abs(touchSteer) > 0.05 ? touchSteer : input.steer
  };
  const v = vehicle;
  const vel = chassisBody.velocity;
  const spd = Math.hypot(vel.x, vel.y, vel.z);
  if (spd > MAX_VELOCITY) { const k = MAX_VELOCITY/spd; vel.x *= k; vel.y *= k; vel.z *= k; }

  const fwdLocal = new CANNON.Vec3(0, 0, 1);
  const fwdWorld = new CANNON.Vec3();
  chassisBody.quaternion.vmult(fwdLocal, fwdWorld);
  const speedAlong = vel.x*fwdWorld.x + vel.y*fwdWorld.y + vel.z*fwdWorld.z;
  const speedAbs = Math.abs(speedAlong);

  const wheelRadius = vehicle.wheelInfos[2].radius;
  updateTransmission(dt, speedAlong, finalInput.throttle, finalInput.brake, wheelRadius);

  const speedKmhSteer = spd * 3.6;
  const speedFactor = 1 / (1 + Math.pow(speedKmhSteer / 45, 1.35));
  const maxSteer = 0.55 * speedFactor;
  const targetSteer = finalInput.steer * maxSteer;

  const steerRate = 1 - Math.pow(0.0005, dt);
  currentSteerAngle += (targetSteer - currentSteerAngle) * steerRate;

  v.setSteeringValue(currentSteerAngle, 0);
  v.setSteeringValue(currentSteerAngle, 1);

  const em = getEngineMultiplier();
  const bc = tireBurst.filter(b => b).length;
  const pl = 1 - bc * 0.15;

  const massFactor = currentCarType === 'gelik' ? 1.6 : 1.0;
  let ef = MAX_FORCE_BASE * powerMul * em * pl * massFactor;
  if (Math.abs(ef) > MAX_ENGINE_FORCE * massFactor) ef = Math.sign(ef) * MAX_ENGINE_FORCE * massFactor;

  const maxSpeed = 60 * Math.pow(powerMul, 0.35);
  const falloff = Math.max(0.05, 1 - speedAbs/maxSpeed);

  if (TRANSMISSION.currentGear === -1 && finalInput.brake > 0.5) {
    v.applyEngineForce(Math.abs(ef)*0.7, 2);
    v.applyEngineForce(Math.abs(ef)*0.7, 3);
    v.setBrake(0, 0); v.setBrake(0, 1);
  } else if (finalInput.throttle > 0 && TRANSMISSION.currentGear > 0) {
    v.applyEngineForce(-ef*falloff, 2);
    v.applyEngineForce(-ef*falloff, 3);
    v.setBrake(0, 0); v.setBrake(0, 1);
  } else if (finalInput.brake > 0.5 && TRANSMISSION.currentGear > 0) {
    if (speedAlong > 1) {
      v.setBrake(70, 0); v.setBrake(70, 1); v.setBrake(60, 2); v.setBrake(60, 3);
      v.applyEngineForce(0, 2); v.applyEngineForce(0, 3);
    } else {
      v.applyEngineForce(0, 2); v.applyEngineForce(0, 3);
      v.setBrake(30, 0); v.setBrake(30, 1);
    }
  } else {
    v.applyEngineForce(0, 0); v.applyEngineForce(0, 1);
    v.applyEngineForce(0, 2); v.applyEngineForce(0, 3);
    v.setBrake(1, 0); v.setBrake(1, 1);
    v.setBrake(1, 2); v.setBrake(1, 3);
  }

  const speedKmh = spd * 3.6;
  let sq = 0;
  if (finalInput.throttle > 0.3 && speedKmh < 25) {
    const sf = Math.max(0, 1 - speedKmh/25);
    sq = Math.max(sq, sf*0.85);
    if (Math.random() < 0.5) {
      for (let i = 2; i < 4; i++) {
        if (tireBurst[i]) continue;
        const wt = vehicle.wheelInfos[i].worldTransform;
        smokePS.spawn(wt.position.x, 0.15, wt.position.z, (Math.random()-0.5)*2, Math.random()*1.5, (Math.random()-0.5)*2, 0.8+Math.random()*0.5, 0.5+Math.random()*0.5);
        addSkidMark(wt.position.x, wt.position.z, 0);
      }
    }
  }
  const lat = Math.hypot(vel.x, vel.z) - Math.abs(speedAlong);
  if (lat > 3) sq = Math.max(sq, Math.min(lat/12, 0.75));
  if (Math.abs(targetSteer) > 0.15 && speedKmh > 30) sq = Math.max(sq, Math.min((speedKmh-30)/80, 0.5));
  if (bc > 0 && spd > 3) sq = Math.max(sq, 0.2);
  audio.update(dt, { rpm: TRANSMISSION.rpm, throttle: finalInput.throttle, squeal: sq });

  for (let i = 0; i < 4; i++) {
    if (tireBurst[i]) continue;
    if (speedKmh > 250) tireHeat[i] = Math.min(tireHeat[i] + dt*(speedKmh-250)*0.1, 100);
    else tireHeat[i] = Math.max(0, tireHeat[i] - dt*20);
    if (tireHeat[i] > 75) {
      tireHealth[i] -= dt * (tireHeat[i]-75) * 0.5;
      if (tireHealth[i] <= 0) burstTire(i);
    }
  }

  if (finalInput.throttle > 0 && fuel > 0) fuel = Math.max(0, fuel - dt*0.15);
  document.getElementById('rpmFill').style.width = Math.min((TRANSMISSION.rpm-700)/7100, 1)*100 + '%';

  let gt;
  if (TRANSMISSION.currentGear === -1) gt = 'R';
  else if (TRANSMISSION.currentGear === 0) gt = 'N';
  else gt = String(TRANSMISSION.currentGear);
  const ge = document.getElementById('gearVal');
  if (ge.textContent !== gt) ge.textContent = gt;
}

