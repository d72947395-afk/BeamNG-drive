<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no,viewport-fit=cover">
<title>BeamNG Drive — City</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;touch-action:none;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;overflow:hidden;background:#0a0e14;
  font-family:system-ui,-apple-system,sans-serif;color:#e8eef5;
  user-select:none;-webkit-user-select:none}
canvas{display:block}
#hud{position:fixed;inset:0;pointer-events:none;z-index:10;transition:opacity .25s}
#speedo{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);
  width:100px;height:100px;border-radius:50%;
  background:radial-gradient(circle at 50% 40%,rgba(18,26,38,.85),rgba(6,10,16,.92));
  border:1.5px solid rgba(90,170,255,.35);
  box-shadow:0 0 18px rgba(60,140,255,.25),inset 0 0 20px rgba(0,0,0,.7);
  display:flex;align-items:center;justify-content:center;opacity:.9}
#speedo .needle{position:absolute;left:50%;top:50%;width:2.5px;height:36px;
  background:linear-gradient(to top,#ff4d4d,#ffd166);border-radius:2px;
  transform-origin:50% 100%;transform:translate(-50%,-100%) rotate(-120deg);
  box-shadow:0 0 8px rgba(255,90,90,.8);transition:transform .06s linear}
#speedo .hub{position:absolute;width:10px;height:10px;border-radius:50%;
  background:#25303f;border:1.5px solid #4d7fb8;z-index:2}
#speedo .val{position:absolute;bottom:20px;text-align:center;line-height:1}
#speedo .num{font-size:22px;font-weight:900;color:#eaf4ff;text-shadow:0 0 10px rgba(90,170,255,.9)}
#speedo .unit{font-size:8px;letter-spacing:2px;color:#7fa5cc;margin-top:2px}
#gearBox{position:absolute;bottom:130px;left:50%;transform:translateX(-50%);
  width:56px;height:56px;border-radius:50%;
  background:radial-gradient(circle,rgba(30,10,10,.9),rgba(10,4,4,.95));
  border:2px solid rgba(255,120,60,.6);
  box-shadow:0 0 14px rgba(255,90,40,.35),inset 0 0 12px rgba(0,0,0,.7);
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  pointer-events:none;transition:border-color .2s,box-shadow .2s}
#gearBox .lbl{font-size:7px;letter-spacing:2px;color:#ff9955;font-weight:800}
#gearBox .val{font-size:22px;font-weight:900;color:#ffe7c8;
  text-shadow:0 0 10px rgba(255,140,60,.9);line-height:1}
#gearBox.manual{border-color:#ff4d4d;box-shadow:0 0 22px rgba(255,60,60,.7),inset 0 0 12px rgba(0,0,0,.7)}
#bars{position:absolute;top:10px;left:50%;transform:translateX(-50%);
  width:min(280px,52vw);display:flex;flex-direction:column;gap:4px}
.bar{height:10px;border-radius:5px;background:rgba(8,14,22,.8);
  border:1px solid rgba(120,170,230,.35);overflow:hidden;position:relative}
.bar i{display:block;height:100%;border-radius:4px;transition:width .15s}
.bar span{position:absolute;left:8px;top:-1px;font-size:7px;line-height:10px;
  letter-spacing:1.5px;color:#cfe4ff;text-shadow:0 1px 3px #000;font-weight:700}
#hpFill{background:linear-gradient(90deg,#ff3b3b,#ffb03b,#3fd67a)}
#tireFill{background:linear-gradient(90deg,#ff3b3b,#ffb03b,#3fd67a)}
#fuelFill{background:linear-gradient(90deg,#ff9f1c,#54d1ff)}
#fps{position:absolute;top:10px;left:10px;font-size:10px;font-weight:700;
  color:#7fe0a0;background:rgba(6,12,20,.75);padding:4px 8px;border-radius:6px;
  border:1px solid rgba(120,170,230,.3)}
#rpmLbl{position:absolute;top:28px;left:10px;font-size:8px;letter-spacing:2px;color:#7fa5cc}
#rpmViz{position:absolute;top:40px;left:10px;width:130px;height:7px;border-radius:4px;
  background:rgba(6,12,20,.7);border:1px solid rgba(120,170,230,.3);overflow:hidden}
#rpmViz i{display:block;height:100%;background:linear-gradient(90deg,#3fd67a,#ffd166,#ff4d4d);width:0%;transition:width .05s linear}
#rpmMark{position:absolute;top:40px;left:105px;width:2px;height:7px;background:#ff4d4d;border-radius:1px}
#btns{position:absolute;top:10px;right:10px;display:flex;flex-direction:column;gap:6px;pointer-events:auto}
.btn{background:rgba(16,26,40,.9);border:1.5px solid rgba(110,170,240,.4);
  color:#cfe6ff;font-size:10px;font-weight:800;padding:8px 10px;border-radius:8px;
  cursor:pointer;letter-spacing:.8px;min-width:84px;text-align:center;line-height:1.2}
.btn:active,.btn.on{background:rgba(70,150,255,.6);border-color:#6fb4ff;transform:scale(.95)}
.btn.green{border-color:#4fe08a;color:#b6ffd4}
.btn.orange{border-color:#ff8a3c;color:#ffd6a8}
.btn.purple{border-color:#c06fff;color:#e8d6ff}
.btn.yellow{border-color:#ffd166;color:#fff3c8}
.btn.blue{border-color:#4db8ff;color:#cceaff}
.btn.red{border-color:#ff6b6b;color:#ffd6d6}
.btn.muted{border-color:#666;color:#888;text-decoration:line-through}
.btn.auto{border-color:#4fe08a;color:#b6ffd4;background:rgba(20,60,30,.85)}
.btn.manualMode{border-color:#ff4d4d;color:#ffc9c9;background:rgba(60,20,20,.85)}
#touch{position:absolute;inset:0;pointer-events:none}
#steer{position:absolute;left:14px;bottom:18px;width:118px;height:118px;
  border-radius:50%;background:radial-gradient(circle,rgba(20,32,48,.6),rgba(10,16,26,.8));
  border:2px solid rgba(110,170,240,.4);pointer-events:auto;
  box-shadow:inset 0 0 20px rgba(0,0,0,.6)}
#knob{position:absolute;left:50%;top:50%;width:48px;height:48px;border-radius:50%;
  transform:translate(-50%,-50%);
  background:radial-gradient(circle at 40% 35%,#5b9be0,#1d3a5c);
  border:2px solid rgba(150,205,255,.6);box-shadow:0 0 14px rgba(90,160,255,.5)}
#pedals{position:absolute;right:14px;bottom:18px;display:flex;gap:10px;align-items:flex-end;pointer-events:auto}
.pedal{width:66px;height:66px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:10px;font-weight:900;border:2px solid;
  transition:.08s;letter-spacing:.5px}
#gas{background:rgba(30,90,50,.6);border-color:#4fe08a;color:#b6ffd4}
#brake{background:rgba(100,30,30,.6);border-color:#ff6b6b;color:#ffc9c9;
  width:58px;height:58px;margin-bottom:5px}
.pedal.on{transform:scale(.9);filter:brightness(1.5)}
#gearBtns{position:absolute;right:92px;bottom:110px;display:flex;flex-direction:column;gap:8px;pointer-events:auto}
.gearBtn{width:52px;height:52px;border-radius:50%;
  background:radial-gradient(circle at 40% 35%,rgba(60,90,140,.95),rgba(20,40,70,.98));
  border:2px solid rgba(120,180,255,.6);color:#cfe6ff;
  display:flex;align-items:center;justify-content:center;
  font-size:20px;font-weight:900;cursor:pointer;
  box-shadow:0 0 12px rgba(80,140,220,.4),inset 0 0 8px rgba(0,0,0,.5);
  user-select:none}
.gearBtn:active{transform:scale(.9);background:rgba(90,150,255,.75);color:#fff}
#dmgFlash{position:fixed;inset:0;pointer-events:none;z-index:20;opacity:0;
  background:radial-gradient(circle,transparent 40%,rgba(255,40,40,.55));transition:opacity .15s}
#vig{position:fixed;inset:0;pointer-events:none;z-index:15;opacity:0;
  background:radial-gradient(circle,transparent 45%,rgba(0,0,0,.85));transition:opacity .25s}
#loader{position:fixed;inset:0;background:#0a0e14;z-index:99;
  display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px}
#loader .ring{width:44px;height:44px;border-radius:50%;
  border:3px solid rgba(110,170,240,.2);border-top-color:#6fb4ff;animation:sp .8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
#loader p{font-size:11px;letter-spacing:3px;color:#5f7f9f}
#loader.hide{display:none}
#err{position:fixed;top:0;left:0;right:0;background:#2a0e0e;color:#ff8888;
  font:12px/1.5 monospace;padding:12px;z-index:100;display:none;
  max-height:60vh;overflow:auto;white-space:pre-wrap;word-break:break-all}
#settingsPanel{position:fixed;top:0;right:0;bottom:0;width:min(320px,86vw);
  background:linear-gradient(180deg,rgba(12,20,32,.98),rgba(6,10,18,.98));
  border-left:2px solid rgba(110,170,240,.5);z-index:50;
  padding:16px 14px;display:flex;flex-direction:column;gap:12px;
  transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);
  overflow-y:auto;box-shadow:-8px 0 30px rgba(0,0,0,.6);pointer-events:auto;
  touch-action:pan-y}
#settingsPanel.open{transform:translateX(0)}
.stTitle{font-size:14px;font-weight:900;letter-spacing:2px;color:#6fb4ff;
  text-align:center;padding-bottom:8px;border-bottom:1px solid rgba(110,170,240,.3)}
.stSection{font-size:9px;font-weight:900;letter-spacing:2px;color:#7fa5cc;
  margin-top:4px;padding-bottom:3px;border-bottom:1px dashed rgba(110,170,240,.2)}
.stRow{display:flex;flex-direction:column;gap:5px}
.stRow.inline{flex-direction:row;justify-content:space-between;align-items:center}
.stRow label{font-size:10px;font-weight:700;color:#cfe4ff;letter-spacing:.5px}
.stRow .val{font-size:10px;font-weight:900;color:#6fb4ff}
.stRow select{background:rgba(20,32,50,.95);border:1.5px solid rgba(110,170,240,.4);
  color:#cfe4ff;font-size:11px;font-weight:700;padding:6px 8px;border-radius:6px;outline:none}
.stRow input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:5px;
  background:rgba(20,32,50,.9);border-radius:3px;outline:none;
  border:1px solid rgba(110,170,240,.3)}
.stRow input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;
  background:radial-gradient(circle at 40% 35%,#5b9be0,#1d3a5c);border-radius:50%;
  border:1.5px solid #6fb4ff;box-shadow:0 0 8px rgba(90,160,255,.7);cursor:pointer}
.stRow input[type=range]::-moz-range-thumb{width:18px;height:18px;
  background:radial-gradient(circle at 40% 35%,#5b9be0,#1d3a5c);border-radius:50%;
  border:1.5px solid #6fb4ff;cursor:pointer}
.stToggle{display:flex;justify-content:space-between;align-items:center;
  background:rgba(20,32,50,.5);padding:6px 10px;border-radius:6px;
  border:1px solid rgba(110,170,240,.25)}
.stToggle span{font-size:10px;font-weight:700;color:#cfe4ff}
.stSwitch{width:38px;height:20px;border-radius:11px;background:rgba(60,20,20,.7);
  border:1.5px solid rgba(255,90,90,.5);position:relative;cursor:pointer;
  transition:.2s}
.stSwitch::after{content:'';position:absolute;width:14px;height:14px;border-radius:50%;
  background:#ff6b6b;top:1.5px;left:2px;transition:.2s;
  box-shadow:0 0 6px rgba(255,90,90,.6)}
.stSwitch.on{background:rgba(20,60,30,.7);border-color:rgba(80,220,140,.6)}
.stSwitch.on::after{background:#4fe08a;left:19px;box-shadow:0 0 6px rgba(80,220,140,.7)}
#setClose{margin-top:auto;background:rgba(70,150,255,.25);
  border:1.5px solid #6fb4ff;color:#cfe6ff;font-size:11px;font-weight:900;
  padding:10px;border-radius:8px;letter-spacing:2px;cursor:pointer}
#setClose:active{background:rgba(70,150,255,.6);transform:scale(.97)}
</style>
</head>
