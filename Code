function rebuildCar(type) {
  if (carGroup) scene.remove(carGroup);
  if (chassisBody) {
    chassisBody.removeEventListener('collide', onCarCollide);
    world.removeBody(chassisBody);
  }
  if (vehicle) vehicle.removeFromWorld(world);
  for (const w of wheelVisuals) scene.remove(w);
  for (const fp of freeParts) {
    if (fp.constraint) world.removeConstraint(fp.constraint);
    scene.remove(fp.holder);
    world.removeBody(fp.body);
  }
  parts = []; deformables = []; freeParts = []; wheelVisuals = [];
  tireHealth = [100,100,100,100]; tireBurst = [false,false,false,false]; tireHeat = [0,0,0,0];
  damage = 0; fuel = 100; currentSteerAngle = 0;
  TRANSMISSION.currentGear = 1; TRANSMISSION.rpm = 800; TRANSMISSION.shiftCooldown = 0;
  buildCar(type);
  applyTirePreset('stock');
}

function applyTirePreset(name) {
  if (!TIRE_PRESETS[name]) return;
  currentPreset = name;
  const p = TIRE_PRESETS[name];
  const cfg = CAR_CFG[currentCarType];
  const rScale = currentCarType === 'gelik' ? 1.39 : 1.0;
  for (let i = 0; i < 4; i++) {
    const isFront = i < 2;
    const wi = vehicle.wheelInfos[i];
    const radius = (isFront ? p.frontR : p.rearR) * rScale;
    const width = (isFront ? p.frontW : p.rearW) * rScale;
    wi.radius = radius;
    wi.suspensionStiffness = isFront ? p.frontStiff : p.rearStiff;
    wi.dampingCompression = isFront ? p.frontDampC : p.rearDampC;
    wi.dampingRelaxation = isFront ? p.frontDampR : p.rearDampR;
    wi.frictionSlip = isFront ? p.frontGrip : p.rearGrip;
    wi.maxSuspensionTravel = isFront ? p.frontTravel : p.rearTravel;
    const ax = WHEEL_ANCHORS[i].x;
    const ay = WHEEL_ANCHORS[i].y + (radius - cfg.wheelR) * 0.5;
    const az = WHEEL_ANCHORS[i].z;
    wi.chassisConnectionPointLocal.set(ax, ay, az);
    scene.remove(wheelVisuals[i]);
    const newW = tireBurst[i] ? createBareRim(radius, width) : createWheelVisual(radius, width);
    scene.add(newW);
    wheelVisuals[i] = newW;
  }
  document.getElementById('btnTire').innerHTML = 'ШИНЫ<br>' + p.name;
}

