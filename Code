const TRANSMISSION = {
  ratios: [3.60, 2.19, 1.55, 1.16, 0.92, 0.75],
  finalDrive: 3.9, currentGear: 1, rpm: 800, idleRpm: 800, maxRpm: 7600,
  shiftUpRpm: 6500, shiftDownRpm: 1800, shiftCooldown: 0, lastShiftTime: 0,
  targetRpm: 800, manualMode: false
};
function updateTransmission(dt, speedMs, throttle, brake, wheelRadius) {
  const T = TRANSMISSION;
  const wc = 2*Math.PI*wheelRadius;
  const wr = (Math.abs(speedMs)/wc) * 60;
  if (T.currentGear === 0 && throttle > 0.15 && T.shiftCooldown <= 0) {
    T.currentGear = 1; T.shiftCooldown = 0.3; audio.playGearShift();
  }
  if (T.currentGear === 0 && brake > 0.5 && speedMs < 0.5 && T.shiftCooldown <= 0) {
    T.currentGear = -1; T.shiftCooldown = 0.3; audio.playGearShift();
  }
  const gi = Math.abs(T.currentGear);
  const ratio = gi >= 1 && gi <= 6 ? T.ratios[gi-1] : T.ratios[0];
  let tr;
  if (T.currentGear === 0) tr = T.idleRpm + throttle*4500;
  else if (T.currentGear === -1) tr = T.idleRpm + wr*ratio*T.finalDrive*0.5 + throttle*1500;
  else {
    if (Math.abs(speedMs) < 0.5 && throttle > 0.05) tr = T.idleRpm + throttle*3500;
    else if (Math.abs(speedMs) < 0.5) tr = T.idleRpm;
    else tr = wr*ratio*T.finalDrive;
  }
  T.targetRpm = tr;
  T.rpm += (tr - T.rpm) * Math.min(dt*5.5, 1);
  T.rpm = Math.max(T.rpm, T.idleRpm); T.rpm = Math.min(T.rpm, T.maxRpm);
  if (T.shiftCooldown > 0) T.shiftCooldown -= dt;
  if (!T.manualMode && T.currentGear > 0 && T.shiftCooldown <= 0) {
    if (T.rpm > T.shiftUpRpm && T.currentGear < 6) {
      T.currentGear++; T.shiftCooldown = 0.25; audio.playGearShift();
    } else if (T.rpm < T.shiftDownRpm && T.currentGear > 1) {
      T.currentGear--; T.shiftCooldown = 0.25; audio.playGearShift();
    }
  }
  if (T.currentGear === -1 && throttle > 0.3 && Math.abs(speedMs) < 0.5 && T.shiftCooldown <= 0) {
    T.currentGear = 1; T.shiftCooldown = 0.4; audio.playGearShift();
  }
  if (T.currentGear === -1 && speedMs > 0.5) T.currentGear = 0;
  return T;
}
function getEngineMultiplier() {
  const T = TRANSMISSION;
  const gi = Math.abs(T.currentGear);
  if (gi === 0) return 0;
  if (T.currentGear === -1) {
    const r = T.ratios[0]*0.9;
    const rn = T.rpm/T.maxRpm;
    const tq = Math.max(0.35, 1 - Math.pow((rn-0.5)*2.2, 2));
    return r*tq;
  }
  const r = T.ratios[gi-1] || T.ratios[0];
  const rn = T.rpm/T.maxRpm;
  const tq = Math.max(0.35, 1 - Math.pow((rn-0.6)*2.2, 2));
  const rl = T.rpm > 7200 ? 0.4 : 1.0;
  return r*tq*rl;
}

