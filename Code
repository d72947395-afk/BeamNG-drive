<script>
window.addEventListener('error', e => {
  const el = document.getElementById('err');
  el.style.display = 'block';
  el.textContent += (e.filename || '') + ':' + (e.lineno || '?') + '\n' + (e.message || '') + '\n\n';
});
window.addEventListener('unhandledrejection', e => {
  const el = document.getElementById('err');
  el.style.display = 'block';
  el.textContent += 'PROMISE: ' + (e.reason && e.reason.stack || e.reason) + '\n\n';
});
</script>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/",
    "cannon-es": "https://cdn.jsdelivr.net/npm/cannon-es@0.20.0/dist/cannon-es.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import * as CANNON from 'cannon-es';
import { mergeVertices } from 'three/addons/utils/BufferGeometryUtils.js';

console.log('=== BeamNG Drive — City ===');

/* ===== 0. ГРАФИКА ===== */
const GRAPHICS = {
  quality: 'high', drawDistance: 400, resolutionScale: 1.0,
  shadows: true, particles: true, fog: true, city: true, skidmarks: true
};
function applyGraphics() {
  if (GRAPHICS.fog) scene.fog = new THREE.Fog(0xc0d5e8, GRAPHICS.drawDistance * 0.25, GRAPHICS.drawDistance);
  else scene.fog = null;
  camera.far = GRAPHICS.drawDistance * 1.6;
  camera.updateProjectionMatrix();
  renderer.shadowMap.enabled = GRAPHICS.shadows;
  sun.castShadow = GRAPHICS.shadows;
  [smokePS, dustPS, sparkPS, debrisPS, rubberPS].forEach(p => { if (p) p.points.visible = GRAPHICS.particles; });
  if (skidMesh) skidMesh.visible = GRAPHICS.skidmarks;
  if (cityGroup) cityGroup.visible = GRAPHICS.city;
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2) * GRAPHICS.resolutionScale);
  renderer.setSize(innerWidth, innerHeight);
}

/* ===== 1. ЗВУК ===== */
class CarAudio {
  constructor() { this.ctx=null; this.ready=false; this.muted=true; this.master=null; this.noiseBuf=null; }
  init() {
    if (this.ready) return;
    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      this.ctx = new AC();
      if (this.ctx.state === 'suspended') this.ctx.resume();
      this.master = this.ctx.createGain(); this.master.gain.value = 0;
      this.master.connect(this.ctx.destination);
      const bs = Math.floor(this.ctx.sampleRate * 2);
      this.noiseBuf = this.ctx.createBuffer(1, bs, this.ctx.sampleRate);
      const d = this.noiseBuf.getChannelData(0);
      for (let i=0;i<bs;i++) d[i]=Math.random()*2-1;
      this._eng(); this._sq(); this.ready = true;
    } catch(e){ console.warn('Audio fail:', e); }
  }
  _eng() {
    const c=this.ctx;
    this.engSub=c.createOscillator(); this.engSub.type='sine'; this.engSub.frequency.value=25;
    this.engSubGain=c.createGain(); this.engSubGain.gain.value=0.7;
    this.engSaw=c.createOscillator(); this.engSaw.type='sawtooth'; this.engSaw.frequency.value=50;
    this.engSqr=c.createOscillator(); this.engSqr.type='square'; this.engSqr.frequency.value=100;
    this.engSqr.detune.value=15;
    this.engNoise=c.createBufferSource(); this.engNoise.buffer=this.noiseBuf; this.engNoise.loop=true;
    this.engNoiseGain=c.createGain(); this.engNoiseGain.gain.value=0.04;
    this.engFilter=c.createBiquadFilter(); this.engFilter.type='lowpass';
    this.engFilter.frequency.value=400; this.engFilter.Q.value=1.5;
    this.engGain=c.createGain(); this.engGain.gain.value=0;
    this.engSub.connect(this.engSubGain); this.engSubGain.connect(this.engGain);
    this.engSaw.connect(this.engGain); this.engSqr.connect(this.engGain);
    this.engNoise.connect(this.engNoiseGain); this.engNoiseGain.connect(this.engGain);
    this.engGain.connect(this.engFilter); this.engFilter.connect(this.master);
    this.engSub.start(); this.engSaw.start(); this.engSqr.start(); this.engNoise.start();
  }
  _sq() {
    const c=this.ctx;
    this.sqOsc=c.createOscillator(); this.sqOsc.type='sawtooth'; this.sqOsc.frequency.value=1800;
    this.sqFilter=c.createBiquadFilter(); this.sqFilter.type='bandpass';
    this.sqFilter.frequency.value=2200; this.sqFilter.Q.value=18;
    this.sqGain=c.createGain(); this.sqGain.gain.value=0;
    this.sqNoise=c.createBufferSource(); this.sqNoise.buffer=this.noiseBuf; this.sqNoise.loop=true;
    this.sqNoiseFilter=c.createBiquadFilter(); this.sqNoiseFilter.type='bandpass';
    this.sqNoiseFilter.frequency.value=3200; this.sqNoiseFilter.Q.value=10;
    this.sqNoiseGain=c.createGain(); this.sqNoiseGain.gain.value=0;
    this.sqOsc.connect(this.sqFilter); this.sqFilter.connect(this.sqGain); this.sqGain.connect(this.master);
    this.sqNoise.connect(this.sqNoiseFilter); this.sqNoiseFilter.connect(this.sqNoiseGain); this.sqNoiseGain.connect(this.master);
    this.sqOsc.start(); this.sqNoise.start();
  }
  enable(){ this.init(); if(!this.ready)return; this.muted=false; this.master.gain.setTargetAtTime(0.35,this.ctx.currentTime,0.1); }
  disable(){ this.muted=true; if(this.master) this.master.gain.setTargetAtTime(0,this.ctx.currentTime,0.05); }
  toggle(){ if(this.muted) this.enable(); else this.disable(); return this.muted; }
  update(dt,o){
    if(!this.ready||this.muted)return;
    const t=this.ctx.currentTime;
    const rpm=o.rpm||800, thr=o.throttle||0, sq=o.squeal||0;
    const rn=Math.max(0,Math.min((rpm-700)/7300,1));
    const bf=22+rn*110;
    this.engSub.frequency.setTargetAtTime(bf*0.5,t,0.03);
    this.engSaw.frequency.setTargetAtTime(bf,t,0.03);
    this.engSqr.frequency.setTargetAtTime(bf*2,t,0.03);
    this.engFilter.frequency.setTargetAtTime(250+rn*2000+thr*2200,t,0.05);
    this.engGain.gain.setTargetAtTime(Math.min(0.12+rn*0.35+thr*0.35,0.85),t,0.06);
    this.engNoiseGain.gain.setTargetAtTime(0.03+thr*0.18,t,0.05);
