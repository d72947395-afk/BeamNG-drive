    }
    if (Math.random() < 0.6 && speed > 2) {
      smokePS.spawn(wt.position.x, 0.1, wt.position.z, (Math.random()-0.5)*1.5, Math.random()*1.5, (Math.random()-0.5)*1.5, 0.6+Math.random()*0.8, 0.4+Math.random()*0.6);
    }
  }

  spdEl.textContent = Math.round(speedKmh);
  const na = -120 + Math.min(speedKmh/250, 1) * 240;
  needle.style.transform = `translate(-50%,-100%) rotate(${na}deg)`;
  hpFill.style.width = (100 - damage) + '%';
  const avgT = (tireHealth[0]+tireHealth[1]+tireHealth[2]+tireHealth[3])/4;
  tireFill.style.width = avgT + '%';
  fuelFill.style.width = fuel + '%';
  vigEl.style.opacity = String(Math.max(0, Math.min((speedKmh-80)/150, 0.7)));

  sun.position.set(carGroup.position.x + 60, 90, carGroup.position.z + 40);
  sun.target.position.copy(carGroup.position);
  sun.target.updateMatrixWorld();

  fpsAccum += dt; fpsFrames++;
  if (fpsAccum >= 0.5) {
    const fps = Math.round(fpsFrames/fpsAccum);
    fpsEl.textContent = fps + ' FPS';
    setFpsEl.textContent = fps + ' FPS';
    fpsAccum = 0; fpsFrames = 0;
  }
  renderer.render(scene, camera);
}

window.addEventListener('resize', () => {
  camera.aspect = innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

try {
  buildCar('sedan');
  buildCity();
  applyTirePreset('stock');
  updateTransBtn();
  applyGraphics();
  setTimeout(() => {
    document.getElementById('loader').classList.add('hide');
    clock.getDelta();
    gameLoop();
  }, 300);
  console.log('=== Ready ===');
} catch (e) {
  document.getElementById('err').style.display = 'block';
  document.getElementById('err').textContent += 'INIT: ' + e.stack + '\n';
  console.error(e);
}
</script>
</body>
</html>
