   ДЕФОРМАЦИЯ — усиленная
   ============================================================================ */
function deformMesh(mesh, worldPoint, worldDir, strength) {
  if (!mesh.geometry.attributes.color) return;
  const pos = mesh.geometry.attributes.position;
  const col = mesh.geometry.attributes.color;
  mesh.updateWorldMatrix(true, false);
  const invWorld = new THREE.Matrix4().copy(mesh.matrixWorld).invert();
  const local = worldPoint.clone().applyMatrix4(invWorld);
  const invQ = new THREE.Quaternion();
  mesh.getWorldQuaternion(invQ); invQ.invert();
  const localDir = worldDir.clone().applyQuaternion(invQ).normalize();
  if (mesh.userData.isThinPanel === undefined) {
    mesh.geometry.computeBoundingBox();
    const bb = mesh.geometry.boundingBox;
    const sy = bb.max.y - bb.min.y;
    const mxz = Math.max(bb.max.x - bb.min.x, bb.max.z - bb.min.z);
    mesh.userData.isThinPanel = sy/mxz < 0.12;
  }
  const fd = localDir.clone();
  if (mesh.userData.isThinPanel && Math.abs(fd.y) < 0.55) {
    fd.x *= 0.35; fd.z *= 0.35; fd.y = -1.0; fd.normalize();
  }
  if (mesh.userData.dmgLevel === undefined) mesh.userData.dmgLevel = 0;
  const fatigue = 1 - Math.min(mesh.userData.dmgLevel, 0.65);
  const eff = strength * fatigue;
  mesh.userData.dmgLevel = Math.min(mesh.userData.dmgLevel + strength * 0.2, 1);
  // ⬇⬇⬇ УВЕЛИЧЕНО: радиус вмятины и глубина
  const R = 1.3;
  const depth = Math.min(eff * 0.9, 1.3);
  const v = new THREE.Vector3();
  let moved = false;
  for (let i = 0; i < pos.count; i++) {
    v.fromBufferAttribute(pos, i);
    const d = v.distanceTo(local);
    if (d < R) {
      const f = 1 - d/R;
      const smooth = f*f*(3-2*f);
      const push = smooth * depth;
      v.x += fd.x*push + (Math.random()-0.5)*push*0.3;
      v.y += fd.y*push + (Math.random()-0.5)*push*0.3;
      v.z += fd.z*push + (Math.random()-0.5)*push*0.3;
      pos.setXYZ(i, v.x, v.y, v.z);
      const c = col.getX(i);
      const dk = Math.max(0.15, c - smooth*0.85);
      col.setXYZ(i, dk, dk*0.9, dk*0.82);
      moved = true;
    }
  }
  if (moved) {
    pos.needsUpdate = true; col.needsUpdate = true;
    mesh.geometry.computeVertexNormals();
    mesh.geometry.computeBoundingSphere();
  }
}

