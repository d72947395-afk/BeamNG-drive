function syncVisuals() {
  carGroup.position.copy(chassisBody.position);
  carGroup.quaternion.copy(chassisBody.quaternion);
  for (let i = 0; i < 4; i++) {
    vehicle.updateWheelTransform(i);
    const wt = vehicle.wheelInfos[i].worldTransform;
    const wv = wheelVisuals[i];
    wv.position.set(wt.position.x, wt.position.y, wt.position.z);
    wv.quaternion.set(wt.quaternion.x, wt.quaternion.y, wt.quaternion.z, wt.quaternion.w);
  }
  for (let i = freeParts.length - 1; i >= 0; i--) {
    const fp = freeParts[i];
    fp.holder.position.copy(fp.body.position);
    fp.holder.quaternion.copy(fp.body.quaternion);
    if (fp.constraint && !fp.broken) {
      const dx = fp.body.position.x - chassisBody.position.x;
      const dy = fp.body.position.y - chassisBody.position.y;
      const dz = fp.body.position.z - chassisBody.position.z;
      const dist = Math.sqrt(dx*dx+dy*dy+dz*dz);
      if (dist > fp.startDistance + fp.maxStretch) {
        world.removeConstraint(fp.constraint);
        fp.constraint = null; fp.broken = true;
        const inv = 1/Math.max(dist, 0.01);
        fp.body.velocity.x += dx*inv*3;
        fp.body.velocity.y += 2;
        fp.body.velocity.z += dz*inv*3;
        const pos = fp.holder.position;
        for (let k = 0; k < 6; k++) sparkPS.spawn(pos.x, pos.y, pos.z, (Math.random()-0.5)*6, Math.random()*5, (Math.random()-0.5)*6, 0.3+Math.random()*0.4, 0.1+Math.random()*0.1);
      }
    }
    if (fp.body.position.y < -20) {
      if (fp.constraint) world.removeConstraint(fp.constraint);
      scene.remove(fp.holder); world.removeBody(fp.body);
      freeParts.splice(i, 1);
    }
  }
}

const camPos = new THREE.Vector3();
