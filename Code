function makeCrack() {
  const c = document.createElement('canvas'); c.width = c.height = 256;
  const x = c.getContext('2d');
  x.fillStyle = 'rgba(200,220,235,0.7)'; x.fillRect(0, 0, 256, 256);
  const cx = 128, cy = 128;
  x.strokeStyle = 'rgba(255,255,255,0.95)';
  for (let i = 0; i < 24; i++) {
    const a = (i/24)*Math.PI*2 + Math.random()*0.3;
    x.beginPath(); x.moveTo(cx, cy);
    let px = cx, py = cy;
    for (let s = 0; s < 6; s++) {
      px += Math.cos(a+(Math.random()-0.5)*0.7)*22;
      py += Math.sin(a+(Math.random()-0.5)*0.7)*22;
      x.lineTo(px, py);
    }
    x.lineWidth = 1 + Math.random()*1.5; x.stroke();
  }
  return new THREE.CanvasTexture(c);
}
function makeBuildingFacade(base) {
  const c = document.createElement('canvas'); c.width = 128; c.height = 256;
  const x = c.getContext('2d');
  x.fillStyle = base; x.fillRect(0, 0, 128, 256);
  const rows = 16, cols = 6, cellW = 128/cols, cellH = 256/rows;
  for (let r = 0; r < rows; r++) for (let ci = 0; ci < cols; ci++) {
    const lit = Math.random() < 0.35;
    const b = 40 + Math.random() * 60;
    if (lit) x.fillStyle = `rgba(255,${200+Math.random()*55},${120+Math.random()*80},${0.6+Math.random()*0.4})`;
    else x.fillStyle = `rgba(${b},${b+10},${b+25},0.9)`;
    x.fillRect(ci*cellW+3, r*cellH+4, cellW-6, cellH-8);
  }
  x.strokeStyle = 'rgba(0,0,0,0.3)'; x.lineWidth = 1;
  for (let r = 0; r <= rows; r++) { x.beginPath(); x.moveTo(0, r*cellH); x.lineTo(128, r*cellH); x.stroke(); }
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  return t;
}
